{
  "manifest_version": 3,
  "name": "Codex 每日用量",
  "version": "0.4.0",
  "description": "按天和模型查看 Codex Token、估算费用与额度快照",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "action": {
    "default_title": "打开 Codex 用量浮窗",
    "default_popup": "dashboard.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
