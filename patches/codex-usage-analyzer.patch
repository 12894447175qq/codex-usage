+ const changed=await analyzeCodexUsage({codexHome:home,previousData:again});assert.equal(changed.sessions[0].usage.totalTokens,600);assert.equal(changed.sessions[0].modelCalls,3);assert.equal(changed.sessions[0].exchanges,3);assert.equal(session.usage.totalTokens,300);
+ assert.equal('rolloutParts' in toPublicUsage(changed).sessions[0],false);assert.equal('messageEvents' in toPublicUsage(changed).sessions[0],false);assert.ok(!JSON.stringify(data).includes('private fixture'));
