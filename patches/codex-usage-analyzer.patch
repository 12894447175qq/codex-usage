+  const newest = parts.at(-1);
+  const calls = unionOccurrences(parts.map(part => part.calls), call => !Number.isFinite(Date.parse(call.timestamp)) ? call : JSON.stringify([
+    call.timestamp, call.turnId, call.model, call.effort, call.serviceTier,
+    call.usage.inputTokens, call.usage.cachedInputTokens, call.usage.outputTokens,
+    call.usage.reasoningOutputTokens, call.usage.totalTokens, call.usage.cacheWriteInputTokens ?? null,
+  ])).sort((a, b) => String(a.timestamp).localeCompare(String(b.timestamp)));
+  const turnById = new Map();
+  for (const part of parts) for (const turn of part.turns) {
+    const old = turnById.get(turn.id);
+    const dates = key => [old?.[key], turn[key]].filter(value => Number.isFinite(Date.parse(value))).sort();
+    turnById.set(turn.id, { ...old, ...turn, startedAt: dates('startedAt')[0] || turn.startedAt, completedAt: dates('completedAt').at(-1) || null });
+  }
+  for (const turn of turnById.values()) { turn.calls = 0; turn.usage = { ...EMPTY_USAGE }; }
+  for (const call of calls) {
+    const turn = turnById.get(call.turnId);
