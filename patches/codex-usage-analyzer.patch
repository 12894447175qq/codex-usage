+const complete=(id,time)=>[row(time,'event_msg',{type:'agent_message',message:'private fixture answer'}),row(time,'event_msg',{type:'task_complete',turn_id:id})];
+const write=async(p,rows)=>writeFile(p,rows.map(JSON.stringify).join('\n')+'\n');
+async function fixture(t){const home=await mkdtemp(path.join(tmpdir(),'codex-segments-'));t.after(()=>rm(home,{recursive:true,force:true}));for(const dir of ['sessions','archived_sessions'])await mkdir(path.join(home,dir));return home;}
