+const afternoon=[meta('same-thread','2026-10-26T06:00:00Z'),...turn('turn-b','2026-10-26T06:00:01Z'),call('2026-10-26T06:00:02Z',200),...complete('turn-b','2026-10-26T06:00:03Z')];
+test('keeps disjoint rollout segments of one conversation and deduplicates archive copies',async t=>{
+ const home=await fixture(t);await write(path.join(home,'sessions','part-a.jsonl'),morning);await write(path.join(home,'sessions','part-b.jsonl'),afternoon);await write(path.join(home,'archived_sessions','copy-a.jsonl'),morning);
+ const data=await analyzeCodexUsage({codexHome:home});assert.equal(data.sessions.length,1);const session=data.sessions[0];assert.equal(session.usage.totalTokens,300);assert.equal(session.modelCalls,2);assert.equal(session.exchanges,2);assert.equal(session.userMessages,2);assert.equal(session.assistantMessages,2);assert.equal(session.durationMs,4000);
