+// Union copies without deleting repeated occurrences inside an individual file.
+function unionOccurrences(lists, keyOf) {
+  const counts = new Map(), values = [];
+  for (const list of lists) {
+    const current = new Map();
+    for (const value of list) {
+      const key = keyOf(value), count = (current.get(key) || 0) + 1;
+      current.set(key, count);
+      if (count > (counts.get(key) || 0)) values.push(value);
+    }
+    for (const [key, count] of current) counts.set(key, Math.max(count, counts.get(key) || 0));
+  }
+  return values;
+}
+
+function mergeSessionFiles(parts) {
