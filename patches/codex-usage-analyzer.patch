+ await write(file,[meta('child','2026-10-26T08:00:00Z'),meta('parent','2026-10-25T01:00:00Z'),...turn('old','2026-10-25T01:00:01Z'),call('2026-10-25T01:00:02Z',900),...complete('old','2026-10-25T01:00:03Z'),...turn('new','2026-10-26T08:00:01Z'),call('2026-10-26T08:00:02Z',100),...complete('new','2026-10-26T08:00:03Z')]);
+ const session=await parseSessionFile(file);assert.equal(session.id,'child');assert.equal(session.startedAt,'2026-10-26T08:00:00Z');assert.equal(session.usage.totalTokens,100);assert.equal(session.exchanges,1);assert.equal(session.userMessages,1);
+});
+test('overlapping segments retain the maximum occurrence count, not a naive sum or a set',async t=>{
