+ await write(path.join(home,'archived_sessions','b.jsonl'),[...morning,...turn('turn-b','2026-10-26T06:00:01Z'),call('2026-10-26T06:00:02Z',200),...complete('turn-b','2026-10-26T06:00:03Z')]);
