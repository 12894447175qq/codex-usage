new file mode 100644
index 0000000000000000000000000000000000000000..5242c2e41355f1b4f1e9c242bdb866936bf3994f
--- /dev/null
+++ b/test/gpt6-pricing.test.mjs
@@ -0,0 +1,49 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { apiCostOfCalls } from '../public/api-pricing.js';
+import { resolveRate } from '../public/pricing-catalog.js';
+
+const call = (model, tier = 'default', timestamp = '2026-10-12') => ({
+  model, serviceTier: tier, timestamp,
+  usage: { inputTokens: 200_000, cachedInputTokens: 100_000, cacheWriteInputTokens: 0, outputTokens: 10_000 },
+});
+const near = (actual, expected) => assert.ok(Math.abs(actual - expected) < 1e-9, `${actual} != ${expected}`);
+
+test('GPT-6 Sol, Luna and 6.1 Sol use their own cache rates and dated launch boundaries', () => {
+  for (const [model, rate, expected, launch] of [
+    ['gpt-6-sol', .2, .32, '2026-09-22'],
+    ['gpt-6-luna', .01, .016, '2026-09-22'],
+    ['gpt-6.1-sol', .1, .31, '2026-09-29'],
+  ]) {
+    const result = apiCostOfCalls([call(model)]);
+    near(result.cost, expected);
+    assert.equal(result.unratedCalls, 0);
+    assert.equal(resolveRate('api', model, '2026-10-12').rate.standard.cached, rate);
+    assert.equal(apiCostOfCalls([call(model, 'default', launch)]).boundaryCalls, 1);
+    assert.equal(apiCostOfCalls([call(model, 'default', '2026-09-21')]).unratedCalls, 1);
+    near(apiCostOfCalls([call(model, 'priority')]).cost, expected * 2);
+    near(apiCostOfCalls([call(model, 'fast')]).cost, expected * 2);
+  }
+});
+
+test('new model cache writes and long context combine once with Fast', () => {
+  const value = call('gpt-6.1-sol', 'fast');
+  value.usage = { inputTokens: 300_000, cachedInputTokens: 100_000, cacheWriteInputTokens: 20_000, outputTokens: 10_000 };
+  // 180K fresh: .72; 100K cached: .02; 20K writes: .10; output: .15; then Fast x2.
+  near(apiCostOfCalls([value]).cost, 1.98);
+});
+
+test('Ultrafast uses its own dated x6 rate; Batch/Flex use half of Standard', () => {
+  near(apiCostOfCalls([call('gpt-6.1-sol', 'ultrafast')]).cost, .31 * 6);
+  assert.equal(apiCostOfCalls([call('gpt-6.1-sol', 'ultrafast', '2026-10-07')]).unratedCalls, 1);
+  assert.equal(apiCostOfCalls([call('gpt-6.1-sol', 'ultrafast', '2026-10-08')]).boundaryCalls, 1);
+  assert.equal(apiCostOfCalls([call('gpt-6-luna', 'ultrafast')]).unratedCalls, 1);
+  near(apiCostOfCalls([call('gpt-6-astra', 'ultrafast')]).cost, 1.6 * 6);
+  for (const tier of ['batch', 'flex']) near(apiCostOfCalls([call('gpt-6.1-sol', tier)]).cost, .31 / 2);
+});
+
+test('reviewing the catalog does not move previously verified historical Fast dates', () => {
+  const result = apiCostOfCalls([call('gpt-5.3-codex', 'priority', '2026-09-06')]);
+  assert.equal(result.unratedCalls, 0);
+  assert.equal(resolveRate('api', 'gpt-5.3-codex', '2026-09-06').rate.fastFrom, '2026-09-05');
+});
